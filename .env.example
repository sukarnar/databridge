# ---------------------------------------------------------------- Hostinger VPS / docker compose
# Copy to /opt/databridge/.env on the VPS and fill in. Keep this file out of git.

DATABRIDGE_HOST=databridge.example.com          # DNS A record -> your VPS IP
GHCR_USER=sukarnar                               # image: ghcr.io/<GHCR_USER>/databridge
IMAGE_TAG=latest

# Match your existing Traefik setup (check its docker-compose / static config)
TRAEFIK_NETWORK=traefik
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt

# First studio admin: created at startup only when no accounts exist yet, and must change the
# password at first sign-in. Remove DATABRIDGE_ADMIN_PASSWORD after that first sign-in.
# (Alternative: docker compose exec app python -m databridge.manage create-admin --username admin)
DATABRIDGE_ADMIN_USERNAME=admin
DATABRIDGE_ADMIN_PASSWORD=

POSTGRES_PASSWORD=change-me-long-random
APP_MEMORY_LIMIT=2g

# ---------------------------------------------------------------- DataBridge
# Fernet key that encrypts saved connection passwords. Generate ONCE and back it up:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing it means re-entering every connection password.
DATABRIDGE_SECRET_KEY=

DATABRIDGE_MAX_UPLOAD_MB=100
DATABRIDGE_NO_CDN=false

# Sign-in and sessions
DATABRIDGE_SESSION_HOURS=12
DATABRIDGE_REMEMBER_DAYS=14
DATABRIDGE_IDLE_MINUTES=60
DATABRIDGE_MAX_FAILED_LOGINS=5
DATABRIDGE_LOCKOUT_MINUTES=15
DATABRIDGE_MIN_PASSWORD_LENGTH=10

# AI (models, prompts, playground, AI-assisted mapping)
DATABRIDGE_AI_ENABLED=true
DATABRIDGE_AI_REQUEST_TIMEOUT=120
DATABRIDGE_AI_MONTHLY_TOKEN_LIMIT=0       # per user; 0 = unlimited
DATABRIDGE_AI_LOG_CONTENT=false           # store prompt/response text in the usage ledger
DATABRIDGE_AI_ALLOW_PRIVATE_URLS=false    # personal keys may only call public https endpoints
# Extra CA certificate(s) trusted for ALL AI calls (e.g. a company CA / TLS-inspecting proxy). Per-endpoint CAs
# and client certificates (mutual TLS) are set in the UI: AI > Models > edit endpoint > Certificates.
DATABRIDGE_AI_CA_BUNDLE=
# Company LLM configuration file applied at startup (endpoints, key modes, model catalog, defaults).
# Example: deploy/llm-config.example.yaml. Keys are referenced by environment variable name, never stored in the file.
DATABRIDGE_AI_CONFIG_FILE=
# Health checks of company model endpoints (minutes; 0 = off) and where alerts go (Slack/Teams incoming webhook URL)
DATABRIDGE_AI_HEALTH_MINUTES=15
DATABRIDGE_AI_ALERT_WEBHOOK=
DATABRIDGE_AI_CERT_WARN_DAYS=14

# Built-in refresh schedule for sources (REST APIs, tables, SQL, files); false = only the Refresh button / API
DATABRIDGE_SOURCE_SCHEDULER=true

# Secure websockets and HTTPS. With an https public address, plain http:// is redirected and ws:// refused;
# the studio (/ws) and the streaming API (/api/v1/stream) then only work as wss://.
DATABRIDGE_REQUIRE_HTTPS=auto              # auto | true | false
DATABRIDGE_ALLOWED_ORIGINS=                # other sites allowed to open websockets, e.g. https://portal.example.com
# DATABRIDGE_TRUSTED_PROXIES=127.0.0.1      # proxies allowed to set X-Forwarded-*; leave unset to keep the Docker image / systemd default
DATABRIDGE_HSTS_SECONDS=31536000
DATABRIDGE_WS_MAX_CONNECTIONS=500
DATABRIDGE_STREAM_MAX_CONNECTIONS=200
DATABRIDGE_WS_MAX_PER_IP=30
DATABRIDGE_STREAM_MAX_PER_KEY=10
DATABRIDGE_STREAM_IDLE_MINUTES=30
# Built-in TLS instead of a proxy (python -m databridge.serve serves https/wss itself). Mount the files and
# set DATABRIDGE_PUBLIC_BASE_URL=https://<name on the certificate>:<port>.
# DATABRIDGE_TLS_CERT_FILE=/certs/databridge.crt   # certificate + intermediates (PEM)
# DATABRIDGE_TLS_KEY_FILE=/certs/databridge.key
# DATABRIDGE_TLS_KEY_PASSWORD=
# DATABRIDGE_TLS_MIN_VERSION=1.2                   # or 1.3
# DATABRIDGE_TLS_CLIENT_CA_FILE=/certs/company-ca.pem
# DATABRIDGE_TLS_CLIENT_CERT=none                  # none | optional | required (mutual TLS)

# Local development only (compose sets these for you on the VPS):
# DATABRIDGE_DATA_DIR=./data
# DATABRIDGE_DATABASE_URL=            # blank = SQLite in DATABRIDGE_DATA_DIR
# DATABRIDGE_PUBLIC_BASE_URL=http://localhost:8000
# If the server needs a proxy for the internet, keep internal LLM hosts off it:
# HTTPS_PROXY=http://proxy.corp.example:8080
# NO_PROXY=localhost,127.0.0.1,.corp.example
